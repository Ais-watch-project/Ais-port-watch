# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# --- Database (used by docker compose and the collector) ---
POSTGRES_USER=ais
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=shiptracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Data sources ---
# Digitraffic needs no key at all. Leave this blank until Weekend 1.
AISSTREAM_API_KEY=

# Where to collect. Default box is the Gulf of Finland (busy, good coverage).
BBOX_LAT=60.15
BBOX_LON=24.95
BBOX_RADIUS_KM=100
